# Kopia av denna fil till .env och fyll i det du behöver.
# Inget av detta krävs för att köra appen lokalt – AI och Stripe är valfria.

PORT=3000
# Publik bas-URL. Används för att bygga länkar i rapporter och cookies.
APP_ORIGIN=http://localhost:3000

# Sätt till true ENDAST om en betrodd reverse proxy skriver över
# X-Forwarded-For. Annars används socket-adressen, så klienter inte kan välja
# sin egen rate-limit-identitet.
TRUST_PROXY=false

# Reserverad. Nuvarande sessioner använder slumpade tokens som hashas i databasen.
SESSION_SECRET=byt-ut-mig-innan-drift

# Första /admin-kontot. Minst 16 tecken; kan tas bort efter att kontot skapats.
# Generera med: openssl rand -hex 32
ADMIN_SETUP_TOKEN=

# Valfritt: AI-formulerad rapporttext. Utan nyckel används deterministiska mallar.
AI_PROVIDER=openai            # openai | anthropic | none
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_BASE_URL=https://api.openai.com/v1
# Krävs utöver AI_API_KEY innan kunddata får skickas till en extern
# AI-leverantör. Sätt först när DPA, överföringsgrund och dokumentation finns.
AI_DATA_PROCESSING_APPROVED=false

# Domän för varumärkets e-post (hello@, privacy@, billing@). Lämna tom tills
# domänen och brevlådorna finns – tomt värde döljer alla adresser på sajten.
BRAND_EMAIL_DOMAIN=

# Transaktionell e-post via Resend. Utan RESEND_API_KEY och MAIL_FROM hamnar
# mejlen i den lokala utkorgen (mail_log) i stället för att skickas.
RESEND_API_KEY=
# Avsändare, till exempel "STOQWISE <hello@example.se>". Domänen måste vara
# verifierad hos Resend.
MAIL_FROM=
# Mottagare av notiser från kontaktformuläret. Tomt värde använder hello@.
MAIL_NOTIFY=

# Kommaseparerade e-postadresser för interna pris-/ekonomiytor i kundappen.
# Påverkar inte /admin, som har separata konton.
PLATFORM_ADMINS=

# Valfritt: Stripe för abonnemang (MVP fungerar utan).
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_MULTI=
STRIPE_WEBHOOK_SECRET=
