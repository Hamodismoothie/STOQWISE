# Kopia av denna fil till .env och fyll i det du behöver.
# Inget av detta krävs för att köra appen lokalt – AI och Stripe är valfria.

PORT=3000
# Publik bas-URL. Används för att bygga länkar i rapporter och cookies.
APP_ORIGIN=http://localhost:3000

# Sessionsnyckel (32+ tecken). Generera med: openssl rand -hex 32
SESSION_SECRET=byt-ut-mig-innan-drift

# Valfritt: AI-formulerad rapporttext. Utan nyckel används deterministiska mallar.
AI_PROVIDER=openai            # openai | anthropic | none
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_BASE_URL=https://api.openai.com/v1

# Domän för varumärkets e-post (hello@, privacy@, billing@). Lämna tom tills
# domänen och brevlådorna finns – tomt värde döljer alla adresser på sajten.
BRAND_EMAIL_DOMAIN=

# Valfritt: Stripe för abonnemang (MVP fungerar utan).
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_MULTI=
STRIPE_WEBHOOK_SECRET=
